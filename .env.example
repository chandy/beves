# Preferred: Vercel Connect (set automatically after `eve add channel/slack` / deploy)
# SLACK_CONNECTOR=slack/beves

# Alternative: self-managed Slack app (portable credentials)
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=...

# Optional: bypass Vercel Deployment Protection for remote health checks
# VERCEL_AUTOMATION_BYPASS_SECRET=
